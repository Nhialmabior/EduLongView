# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
PORT=8000

# Required to authorise API requests. Use a long random value locally.
# This shared-token mode is for local testing only; do NOT expose it in a public browser app.
EDULONGVIEW_API_TOKEN=replace-with-a-long-random-secret

# OpenAI-compatible chat-completions provider configuration.
# Leave AI_API_KEY blank until an approved provider and data-processing arrangement are in place.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# Comma-separated exact origins. Add your deployed frontend only after reviewing auth.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
MAX_EVIDENCE_RECORDS=200
