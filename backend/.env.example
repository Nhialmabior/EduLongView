# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
PORT=8000

# Supabase project settings. The publishable key is not an admin secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server only. Use the legacy service_role key or current secret key as appropriate.
# NEVER put this value in frontend JavaScript or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY

# OpenAI-compatible chat-completions provider configuration.
# Leave AI_API_KEY blank until an approved provider and data-processing arrangement are in place.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# Comma-separated exact origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
MAX_EVIDENCE_RECORDS=200
